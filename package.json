{
  "name": "outreach-automation-pipeline",
  "version": "1.0.0",
  "description": "Automated cold outreach pipeline: Ocean.io, Prospeo, Brevo",
  "type": "module",
  "scripts": {
    "dev": "node init && tsx src/index.ts",
    "build": "node init && tsc",
    "start": "node init && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke:config": "tsx scripts/smoke-config.ts",
    "smoke:template": "tsx scripts/smoke-template.ts",
    "smoke:validate": "tsx scripts/smoke-validate.ts"
  },
  "keywords": [
    "outreach",
    "automation",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "chalk": "^5.4.1",
    "inquirer": "^12.6.3",
    "node-fetch": "^3.3.2",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
